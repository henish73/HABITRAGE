{
  "name": "financeos-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter @financeos/mobile start",
    "build:web": "pnpm --filter web build",
    "lint": "turbo lint",
    "seed": "pnpm --filter @financeos/db seed",
    "generate": "pnpm --filter @financeos/db generate",
    "test": "pnpm --filter @financeos/db test"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.14.0"
}
