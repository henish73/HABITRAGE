# Copy to .env.local for development. In production set these in your host's
# secret manager; never commit real values.

# Required in production. Signs session cookies; 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Required in production. The passcode that unlocks the vault (12+ characters required in production).
FINANCEOS_PASSCODE=

# How many proxies sit in front of the app and append to X-Forwarded-For
# (1 for Cloud Run / Vercel / a single nginx). Used for login rate limiting.
TRUSTED_PROXY_HOPS=1

# Where the JSON ledger is stored. Point it at a persistent volume in containers.
# FINANCEOS_DATA_FILE=/app/data/seed_cache.json

# AI assistant (optional). Without a key the assistant answers from built-in rules.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Postgres mirror (optional).
DATABASE_URL=
DIRECT_URL=
