# Copy to .env.local for development. In production set these in your host's
# secret manager; never commit real values.

# Required in production. Signs session cookies; 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Required in production. The passcode that unlocks the vault (12+ characters required in production).
FINANCEOS_PASSCODE=

# Owner identifier for multi-user readiness (defaults to "owner")
OWNER_ID=owner

# Database Connections (PostgreSQL with SSL required in production)
# DATABASE_URL: Pooled connection for application queries (on Supabase: port 6543 with ?pgbouncer=true&connection_limit=1&sslmode=require)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require

# DIRECT_URL: Direct unpooled connection used ONLY for prisma migrations (port 5432 with ?sslmode=require)
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# How many proxies sit in front of the app and append to X-Forwarded-For
# (1 for Cloud Run / Vercel / a single nginx). Used for login rate limiting.
TRUSTED_PROXY_HOPS=1

# AI assistant (optional). Without a key the assistant answers from built-in rules.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
